{
  "name": "space-structures-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive structural engineering laboratory for space structures",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 5180",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "shots": "playwright test tests/visual"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.2",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
